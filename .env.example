# 忍者之夜 — 环境变量示例
# 复制为 .env 或在 shell 中导出；默认值见 src/shared/timeouts.ts

# 决策窗口超时（毫秒）
NINJA_WINDOW_MS=60000

# 空房清理（毫秒）
NINJA_EMPTY_ROOM_TTL_MS=300000

# 对局结束后房间保留（毫秒）
NINJA_ENDED_ROOM_TTL_MS=600000

# 单 socket 每秒指令上限
NINJA_COMMAND_RATE_PER_SEC=10

# 断线座位保留（毫秒）
NINJA_DISCONNECT_RETAIN_MS=300000

# victoryCheck 单人房自动进下一轮延迟（毫秒；结算展示留足反应时间）
NINJA_VICTORY_AUTO_MS=10000

# 服务端端口
PORT=3000

# ---- 6J 种子机制 ----
# 固定对局种子（dev/复现用；注释掉或留空则每局随机）
# NINJA_SEED=42

# ---- 6G-1 语音连麦（mediasoup SFU，纯音频） ----
# 对外宣告的局域网 IP（留空则启动时自动探测 192.168/10.x 兜底）
NINJA_MEDIA_ANNOUNCED_IP=
# mediasoup 监听地址（一般不动）
NINJA_MEDIA_LISTEN_IP=0.0.0.0
# mediasoup RTC UDP 端口段（Windows 防火墙需放行 UDP 40000-40100）
NINJA_MEDIA_PORT_MIN=40000
NINJA_MEDIA_PORT_MAX=40100
# 离线安装 mediasoup 时跳过预编译二进制下载，改为本地编译
MEDIASOUP_SKIP_WORKER_PREBUILT_DOWNLOAD=true
# 自签证书 https 开关（0=http 开发模式；1=局域网 https，需先 npm run certs）
NINJA_TLS=0

# ---- 6I 线上部署 ----
# Socket.IO CORS 白名单（逗号分隔；留空=全放行，开发/局域网用；
# 生产设为 Vercel 域名，如 https://ninja-night.vercel.app）
NINJA_CORS_ORIGIN=
# 语音总开关（0=彻底禁用语音，Railway 免费层用；默认启用/懒启动，失败自动降级）
NINJA_VOICE=1
# 前端构建时后端地址（Vercel 环境变量；本地留空=同源）
# VITE_API_BASE_URL=https://your-backend.up.railway.app

# ========== LLM 配置（服务端；默认关闭） ==========
LLM_ENABLED=false
LLM_ENDPOINT=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-REPLACE_ME
LLM_TIMEOUT_MS=8000
LLM_MAX_CALLS_PER_ROUND=3
LLM_MIN_INTERVAL_MS=5000

# 思考模式：enabled（默认）/ disabled；社交场景建议 enabled + low
LLM_THINKING_TYPE=enabled
# 思考强度：low / high / max
LLM_REASONING_EFFORT=low

# ---- Bot 拟人延迟（毫秒；src/server/bot-scheduler.ts） ----
BOT_DELAY_MS=1000
BOT_JITTER_MS=1000

# ---- 6G-2 互动特效 / 怀疑标记 / 反应（src/shared/timeouts.ts） ----
# 特效合并发送窗口（毫秒）
NINJA_EFFECT_BATCH_MS=50
# 单批最多压缩条目
NINJA_EFFECT_BATCH_MAX=64
# 单条压缩记录最多粒子数
NINJA_EFFECT_MAX_COUNT=1000
# 特效 payload 硬上限（字节）
NINJA_EFFECT_PAYLOAD_MAX_BYTES=262144
# Canvas 粒子池上限
NINJA_EFFECT_PARTICLE_MAX=200
# 每人最多怀疑标记数
NINJA_MARK_PER_SEAT_MAX=2
# reaction 独立限频（每 socket 每秒）
NINJA_REACTION_RATE_PER_SEC=30

# ---- mimo TTS 配置（离线脚本用） ----
MIMO_API_KEY=sk-REPLACE_ME
