{
  "name": "ninja-night",
  "version": "0.0.1",
  "private": true,
  "description": "《忍者之夜》中文网页多人联机游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx scripts/dev-server.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsc -b && vite build",
    "build:check": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "start": "node --import tsx scripts/prod-server.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:preview": "tsx scripts/gen-assets/preview-prompts.ts",
    "gen:slice": "tsx scripts/gen-assets/slice-sheet.ts",
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "bench": "tsx scripts/bench/run.ts",
    "certs": "tsx scripts/gen-certs.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mediasoup": "^3.27.1",
    "mediasoup-client": "^3.23.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^25.5.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
